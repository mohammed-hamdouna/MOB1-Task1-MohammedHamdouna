<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:clickable="true"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="409dp"
        android:layout_height="730dp"
        android:background="?attr/colorTertiaryFixed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="204.5dp"
            android:layout_height="match_parent"
            android:background="?attr/colorTertiaryFixedDim"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="364dp"
                android:gravity="center"
                android:text="@string/quadrant1_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="365dp"
                android:background="?attr/colorTertiaryContainer"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/quadrant4_text"
                    android:textColor="@color/black" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="204.5dp"
            android:layout_height="match_parent"
            android:background="?attr/colorTertiaryFixedDim"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="365dp"
                android:background="?attr/colorTertiaryContainer"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/quadrant2_text" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="367dp"
                android:gravity="center"
                android:text="@string/quadrant3_text" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>